# Production Environment Variables
# Copy this file to .prod.env and fill in the actual values

# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=find_artek_django
MYSQL_USER=find_artek_user
MYSQL_PASSWORD=your_db_password_here

# Django Configuration
SECRET_KEY=your_very_long_secret_key_here
DEBUG=False

# Cron Configuration
ENABLE_CRON=true
THUMBNAIL_HEIGHT=400

# Network Drive Configuration for CIFS
# These are required for production CIFS volume mounting
NETWORK_DRIVE_HOST=ait-pdfs
NETWORK_DRIVE_SHARE=Qdrev/SUS/Groups/Arctic_web-data/SUS-PArcWeb01
NETWORK_DRIVE_USER=SUS-Usr-Arctic-web@win.dtu.dk
NETWORK_DRIVE_PASSWORD=your_network_drive_password_here
