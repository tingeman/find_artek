{
    "name": "Find Artek Django Dev Container",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "../docker-compose.develop.yml", 
        "docker-compose.yml"
    ],
    "service": "webapp-find-artek",
    "workspaceFolder": "/workspace",
    "overrideCommand": false,
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/src/venv/bin/python"
            },
            "extensions": [
                "ms-python.python",
                "rogalmic.bash-debug"
            ]
        }
    },
    
    "postCreateCommand": "bash /workspace/.devcontainer/postCreateCommand.sh"
}
