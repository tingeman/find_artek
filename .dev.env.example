# Development Environment Variables
# Copy this file to .dev.env and fill in the actual values

# Database Configuration
MYSQL_ROOT_PASSWORD=dev_root_password
MYSQL_DATABASE=find_artek_django
MYSQL_USER=find_artek_user
MYSQL_PASSWORD=dev_password

# Django Configuration
SECRET_KEY=development_secret_key_not_for_production_use_only
DEBUG=True

# Cron Configuration
ENABLE_CRON=false
THUMBNAIL_HEIGHT=400

# LDAP lookups (read-only AD account; settings.py)
# USE_LDAP: true/false (also 1/0, yes/no, on/off; unset or empty = true). false: no LDAP
# connection at all (roles and user names stay as stored, the Excel import matches only
# persons already in the database); then the LDAP_* values below are not needed.
# USE_LDAP=true
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Roles from AD (publications/roles.py, at every CAS login): full DN of the AD group whose
# members get the Django group artek_staff / artek_editor. Empty = nobody has the role.
LDAP_GROUP_ARTEK_STAFF=
LDAP_GROUP_ARTEK_EDITOR=
