# Image and tool pins for deterministic builds (read by scripts/compile_lock.py and checked
# by tests/run.sh against the Dockerfile).
#
# Base image of the Dockerfile: python 3.13.18-slim-trixie (Debian 13 trixie), pinned by the
# index digest (multi-arch; image created 2026-11-05). Trixie since the Django 5.2 upgrade
# (PLAN_django-5 T5): Django 5.2's system check gis.W001 warns for GDAL < 3.9, bookworm has
# GDAL 3.6, trixie 3.10. Production then ran Python 3.12.11 on Debian 12 (host baseline
# 2026-11-16); the image is self-contained, the host Python does not matter. Keep it
# identical to the Dockerfile's ARG PYTHON_IMAGE default and change both together:
# build_image.sh builds without --build-arg, so the Dockerfile default is what a release uses.
# To update: docker buildx imagetools inspect python:3.13-slim-trixie, then change both
# places and recompile the locks (scripts/compile_lock.py).
FA_PYTHON_IMAGE=python:3.13.18-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

# uv version used by scripts/compile_lock.py to write the lock files (not part of the image).
# Same as webapp_nukissiorfiit and monitoring_db, so the repositories resolve the same way.
FA_UV_VERSION=0.8.22

# Dev database and phpMyAdmin (docker-compose.develop.yml) and the test database of
# tests/run.sh: the images production runs (host baseline 2026-11-16, docs/plan/BASELINE on
# develop/main: mariadb:11.2 = MariaDB 11.2.6, phpmyadmin/phpmyadmin:latest), pinned by the
# repo digest. Same values as web_server's pins.env (M5, FA4). Written out in
# docker-compose.develop.yml (no --env-file needed); tests/run.sh checks the copies match.
FA_MARIADB_IMAGE=mariadb:11.2@sha256:8fab5714514314b67ccfcb38a971fd99624d8dd0dc3e1fc365d0504a18b9f4f3
FA_PHPMYADMIN_IMAGE=phpmyadmin/phpmyadmin@sha256:67ba2550fd004399ab0b95b64021a88ea544011e566a9a1995180a3decb6410d
