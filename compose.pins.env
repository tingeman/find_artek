# Image and tool pins for deterministic builds (read by scripts/compile_lock.py and checked
# by tests/run.sh against the Dockerfile).
#
# Base image of the Dockerfile: python 3.12.11-slim-bookworm (Debian 12 bookworm), pinned by
# the index digest (multi-arch). The Python version production runs (host baseline
# 2026-11-16: Python 3.12.11 on Debian 12). Keep it identical to the Dockerfile's
# ARG PYTHON_IMAGE default and change both together: build_image.sh builds without
# --build-arg, so the Dockerfile default is what a release uses.
# To update: docker buildx imagetools inspect python:3.12-slim-bookworm, then change both
# places and recompile the locks (scripts/compile_lock.py).
FA_PYTHON_IMAGE=python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7

# uv version used by scripts/compile_lock.py to write the lock files (not part of the image).
# Same as webapp_nukissiorfiit and monitoring_db, so the repositories resolve the same way.
FA_UV_VERSION=0.8.22

# Dev database and phpMyAdmin (docker-compose.develop.yml) and the test database of
# tests/run.sh: the images production runs (host baseline 2026-11-16, docs/plan/BASELINE on
# develop/main: mariadb:11.2 = MariaDB 11.2.6, phpmyadmin/phpmyadmin:latest), pinned by the
# repo digest. Same values as web_server's pins.env (M5, FA4). Read by compose through
# --env-file compose.pins.env.
FA_MARIADB_IMAGE=mariadb:11.2@sha256:8fab5714514314b67ccfcb38a971fd99624d8dd0dc3e1fc365d0504a18b9f4f3
FA_PHPMYADMIN_IMAGE=phpmyadmin/phpmyadmin@sha256:67ba2550fd004399ab0b95b64021a88ea544011e566a9a1995180a3decb6410d
