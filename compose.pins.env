# Image pins for deterministic builds.
#
# Base image of the Dockerfile: python 3.12.16-slim-bookworm, pinned by digest (provisional,
# until the host baseline confirms the Python version production runs). Keep it identical to
# the Dockerfile's ARG PYTHON_IMAGE default and change both together: build_image.sh builds
# without --build-arg, so the Dockerfile default is what a release uses.
# To update: docker buildx imagetools inspect python:3.12-slim-bookworm, then change both places.
FA_PYTHON_IMAGE=python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
